generation
buildMethodHeader
	"Write the method selector header and optional comments into the code stream. When
	 targetSelector is nil the source is template-driven (the full method source, including
	 its header, is supplied via sourceString and compiled directly), so no header is built."

	self targetSelector ifNil: [ ^ self ].
	self codeStream nextPutAll: self targetSelector.
	self commentNewMethod
		ifTrue: [ self codeStream nextPutAll: self autogeneratedComment ].
	self commentUserMethod
		ifTrue: [ self codeStream nextPutAll: self userComment ]