naming
singularizationExceptions
	"Answer a <Set> of lowercase words that must NOT be singularized by dropping a trailing
	 's' (they are not plurals)."

	^ #( 'status' 'address' 'series' 'species' 'news' 'analysis'
	     'basis' 'bus' 'lens' 'bonus' 'campus' 'gas' 'alias' 'atlas'
	     'canvas' ) asSet