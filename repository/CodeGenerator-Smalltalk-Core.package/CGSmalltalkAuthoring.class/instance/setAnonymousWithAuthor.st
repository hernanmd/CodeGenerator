authoring
setAnonymousWithAuthor
	"Private - Remember the current author identity and set an anonymous name during code
	 generation, using the live Author class API. A no-op when no Author class is present."

	| authorClass |
	(Smalltalk hasClassNamed: #Author) ifFalse: [ ^ self ].
	authorClass := Smalltalk at: #Author.
	(authorClass respondsTo: #fullName) ifTrue: [
		identity := authorClass fullName ].
	(authorClass respondsTo: #fullName:) ifTrue: [
		authorClass fullName: self autogeneratedName ]